# Cấu hình môi trường cơ bản
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/dcp
REDIS_URL=redis://localhost:6379

# Cấu hình Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Cấu hình JWT
JWT_SECRET=your_strong_jwt_secret_min_32_chars
JWT_ISSUER=dcp-backend
JWT_AUDIENCE=dcp-users
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# =====================================#
# ===== Guest Session JWT (FR5.G) =====#
# =====================================#
# Secret riêng cho guest session token — tách biệt hoàn toàn với JWT_SECRET
GUEST_JWT_SECRET=your_strong_guest_jwt_secret_min_32_chars
GUEST_JWT_ISSUER=dcp-guest
GUEST_JWT_AUDIENCE=dcp-guest-sessions
GUEST_JWT_EXPIRES_IN=72h

# Cấu hình CORS (comma-separated cho nhiều origin)
# Production: cho phép cả localhost (dev) và domain thật
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://tuthienminhbach.online

# Cấu hình production/runtime
REQUEST_BODY_LIMIT=5mb
RUN_WORKERS=true
EVENT_LOGGER_ENABLED=true
EVENT_LOGGER_TICK_MS=5000
EVENT_LOGGER_BATCH_SIZE=100
EVENT_LOGGER_FLUSH_INTERVAL_MS=300000
EVENT_LOGGER_INFLIGHT_RECOVERY_INTERVAL_MS=60000
EVENT_LOGGER_BUFFER_MAX=50000
EVENT_ARCHIVE_ENABLED=false
AUDIT_ARCHIVE_ENABLED=false
# Bật trên đúng một container BE để purge feedback đã xoá mềm sau 30 ngày.
FEEDBACK_PURGE_ENABLED=
# Private S3-compatible endpoint đã bao gồm bucket/path; worker dùng PUT immutable + checksum verify.
AUDIT_ARCHIVE_S3_ENDPOINT=
AUDIT_ARCHIVE_S3_BEARER_TOKEN=
# Comma-separated exact host allowlist; bắt buộc khi AUDIT_ARCHIVE_ENABLED=true.
AUDIT_ARCHIVE_S3_ALLOWED_HOSTS=

# ========================================#
# == FR2 - Kênh thanh toán (nhận tiền) == #
# ========================================#
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# Redirect URLs
PAYOS_RETURN_URL=http://localhost:3000/deposit?paymentStatus=success
PAYOS_CANCEL_URL=http://localhost:3000/deposit?paymentStatus=cancel

# =====================================#
# ===== FR8 - Kênh chuyển tiền    =====#
# =====================================#
PAYOS_TRANSFER_CLIENT_ID=your_payos_transfer_client_id
PAYOS_TRANSFER_API_KEY=your_payos_transfer_api_key
PAYOS_TRANSFER_CHECKSUM_KEY=your_payos_transfer_checksum_key
PAYOS_TRANSFER_API_URL=https://api-merchant.payos.vn/v1/payouts
PAYOS_TRANSFER_TIMEOUT_MS=30000
SUPER_ADMIN_USER_ID=admin_user_id_for_manual_review_escalation

# Cấu hình Pinata/IPFS
PINATA_JWT=your_pinata_jwt_token
# IPFS gateway để oracle worker fetch buffer ảnh theo CID (mặc định: https://ipfs.io/ipfs)
IPFS_GATEWAY_URL=https://ipfs.io/ipfs

# =====================================#
# ===== ZeroDev - Account Abstraction ===#
# =====================================#
ZERODEV_PROJECT_ID=your_zerodev_project_id

# ZeroDev - RPC URL (Polygon Amoy)
ZERODEV_RPC_URL=https://rpc.zerodev.app/api/v3/{PROJECT_ID}/chain/80002

# ZeroDev - Bundler URL
ZERODEV_BUNDLER_URL=https://rpc.zerodev.app/api/v3/{PROJECT_ID}/chain/80002

# ZeroDev - Paymaster URL
ZERODEV_PAYMASTER_URL=https://rpc.zerodev.app/api/v3/{PROJECT_ID}/chain/80002

# Optional: EntryPoint (mặc định dùng v0.7)
# ZERODEV_ENTRYPOINT_ADDRESS=0x00000000...

# =====================================#
# ===== Địa chỉ Contract (Amoy) =====#
# =====================================#
CHARITY_TOKEN_ADDRESS=your_charity_token_address
DONATION_RANKING_ADDRESS=your_donation_ranking_address
MULTISIG_DISBURSEMENT_ADDRESS=your_multisig_disbursement_address
# ImpactSBT — ERC-5192 soulbound certificate, Oracle mint cho beneficiary
IMPACT_SBT_ADDRESS=your_impact_sbt_address

# =====================================#
# ===== Blockchain Config (Amoy) =====#
# =====================================#
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology
BLOCKCHAIN_CHAIN_ID=80002
BACKEND_MINTER_PRIVATE_KEY=your_backend_minter_private_key
# EOA riêng cho ImpactSBT mint; chỉ grant ORACLE_ROLE trên ImpactSBT
IMPACT_SBT_MINTER_PRIVATE_KEY=your_impact_sbt_minter_private_key
CHARITY_TOKEN_CONTRACT_ADDRESS=your_charity_token_address

# =====================================#
# ===== FR9 - Relay Donation =====#
# =====================================#
DONATION_RANKING_CONTRACT_ADDRESS=your_donation_ranking_address
DONATION_RELAYER_PRIVATE_KEY=your_donation_relayer_private_key

# =====================================#
# ===== Auto-grant Organization Role =====#
# =====================================#
DONATION_ADMIN_PRIVATE_KEY=your_donation_admin_private_key

# =====================================#
# ===== Smart Account Encryption =====#
# =====================================#
# Khóa mã hóa AES-256-GCM để bảo vệ owner private key của guest wallets trong DB.
# Dùng cho Backend Relay (Cách 2) - không liên quan đến registered user.
# Format: chuỗi hex 64 ký tự (32 bytes) - KHÔNG có prefix 0x.
# Tạo key mới: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# LƯU Ý: Key này rất quan trọng - nếu mất, tất cả guest wallet owner keys trong DB không thể giải mã được.
# BACKUP KEY NÀY Ở NƠI AN TOÀN!
SMART_ACCOUNT_ENCRYPTION_KEY=your_smart_account_encryption_key

# =====================================#
# ===== E2 - Multi-channel Delivery ====#
# =====================================#

# Gmail SMTP — gửi email notification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=DCP Notification <your_email@gmail.com>

# Firebase Cloud Messaging (FCM) — gửi push notification
# Lấy từ Firebase Console > Project Settings > Service Accounts
FCM_PROJECT_ID=your_firebase_project_id
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_ESCAPED_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FCM_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com

# Twilio — gửi SMS notification
# Lấy từ Twilio Console
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# LARGE_DONATION threshold — ngưỡng donation lớn để trigger EMAIL (default: 10000000 VND = 10M)
LARGE_DONATION_EMAIL_THRESHOLD_VND=10000000

# Frontend URL — dùng cho unsubscribe link trong email
FRONTEND_URL=http://localhost:3000

# =====================================#
# ===== Cache integrity & cursor =====#
# =====================================#
# HMAC key dùng để ký cache payload (Redis/in-memory). Rotate định kỳ.
# Format: chuỗi hex hoặc chuỗi ngẫu nhiên ≥32 bytes.
# Neu khong cau hinh, fallback ve JWT_SECRET (de tuong thich nguoc nhung khong khuyen khich).
# Tao key moi: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CACHE_HMAC_KEY=your_cache_hmac_key_min_32_chars

# Muối bí mật dùng để băm IP của feedback công khai; không đưa giá trị thật vào mã nguồn.
FEEDBACK_IP_HASH_SALT=

# Khóa HMAC ký ticket feedback công khai; môi trường production yêu cầu tối thiểu 32 ký tự.
FEEDBACK_TICKET_HMAC_KEY=


# HMAC key dùng để ký cursor (defense-in-depth). Neu khong cau hinh, fallback ve JWT_SECRET.
UNIFIED_CURSOR_HMAC_KEY=your_cursor_hmac_key_min_32_chars

# =====================================#
# ===== E5 - Prometheus Metrics ======#
# =====================================#
# Bearer token bảo vệ GET /metrics; production bắt buộc phải cấu hình.
# Tạo token mới: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
METRICS_AUTH_TOKEN=your_metrics_auth_token_min_32_chars

# ========================================#
# ===== E6 - Structured logging =========#
# ========================================#
# LOG_DRIVER=console  -> kill-switch quay về console logger cũ
LOG_DRIVER=winston
LOG_LEVEL=info
LOG_DIR=logs
LOG_FILE_ENABLED=true

# ========================================#
# ===== E7 - Sentry error tracking ======#
# ========================================#
# DSN project Sentry cho backend. Để trống = tắt Sentry, không crash app.
SENTRY_DSN=

# Nhãn environment trên dashboard, tách khỏi NODE_ENV để hỗ trợ staging.
SENTRY_ENVIRONMENT=development

# Phải trùng release lúc build image để Sentry ghép source map.
SENTRY_RELEASE=

# Tỉ lệ transaction production trong [0,1]; giá trị không hợp lệ dùng 0.1.
SENTRY_TRACES_SAMPLE_RATE=0.1

# Ghi đè process name; bỏ trống sẽ suy từ RUN_WORKERS.
SENTRY_SERVER_NAME=
