      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments" /></elementProp>
    </TestPlan>
    <hashTree>
<Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="Runtime Variables" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="protocol" elementType="Argument"><stringProp name="Argument.name">protocol</stringProp><stringProp name="Argument.value">${__P(protocol,http)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="host" elementType="Argument"><stringProp name="Argument.name">host</stringProp><stringProp name="Argument.value">${__P(host,localhost)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="port" elementType="Argument"><stringProp name="Argument.name">port</stringProp><stringProp name="Argument.value">${__P(port,4000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="repo_root" elementType="Argument"><stringProp name="Argument.name">repo_root</stringProp><stringProp name="Argument.value">${__P(repo_root,D:/CODE/DCP_ver3.0)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="kyc_access_token" elementType="Argument"><stringProp name="Argument.name">kyc_access_token</stringProp><stringProp name="Argument.value">${__P(kyc_access_token,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="organization_access_token" elementType="Argument"><stringProp name="Argument.name">organization_access_token</stringProp><stringProp name="Argument.value">${__P(organization_access_token,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="regulatory_access_token" elementType="Argument"><stringProp name="Argument.name">regulatory_access_token</stringProp><stringProp name="Argument.value">${__P(regulatory_access_token,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="donor_access_token" elementType="Argument"><stringProp name="Argument.name">donor_access_token</stringProp><stringProp name="Argument.value">${__P(donor_access_token,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="committee_chair_access_token" elementType="Argument"><stringProp name="Argument.name">committee_chair_access_token</stringProp><stringProp name="Argument.value">${__P(committee_chair_access_token,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="committee_member1_access_token" elementType="Argument"><stringProp name="Argument.name">committee_member1_access_token</stringProp><stringProp name="Argument.value">${__P(committee_member1_access_token,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="committee_member2_access_token" elementType="Argument"><stringProp name="Argument.name">committee_member2_access_token</stringProp><stringProp name="Argument.value">${__P(committee_member2_access_token,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="kyc_org_name" elementType="Argument"><stringProp name="Argument.name">kyc_org_name</stringProp><stringProp name="Argument.value">${__P(kyc_org_name,DCP E2E Test Organization)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="kyc_legal_registration_number" elementType="Argument"><stringProp name="Argument.name">kyc_legal_registration_number</stringProp><stringProp name="Argument.value">${__P(kyc_legal_registration_number,DCP-E2E-CHANGE-ME)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="kyc_file_base64" elementType="Argument"><stringProp name="Argument.name">kyc_file_base64</stringProp><stringProp name="Argument.value">${__P(kyc_file_base64,JVBERi0xLjQK)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="bank_account_number" elementType="Argument"><stringProp name="Argument.name">bank_account_number</stringProp><stringProp name="Argument.value">${__P(bank_account_number,970400000001)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="e2e_donation_amount" elementType="Argument"><stringProp name="Argument.name">e2e_donation_amount</stringProp><stringProp name="Argument.value">${__P(e2e_donation_amount,20000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="e2e_disbursement_amount" elementType="Argument"><stringProp name="Argument.name">e2e_disbursement_amount</stringProp><stringProp name="Argument.value">${__P(e2e_disbursement_amount,10000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="evidence_cid_1" elementType="Argument"><stringProp name="Argument.name">evidence_cid_1</stringProp><stringProp name="Argument.value">${__P(evidence_cid_1,QmYwAPJzv5CZsnAzt8auVZRnqEy1B5HfM9Q5e7vJ6C4abc)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="evidence_cid_2" elementType="Argument"><stringProp name="Argument.name">evidence_cid_2</stringProp><stringProp name="Argument.value">${__P(evidence_cid_2,QmYwAPJzv5CZsnAzt8auVZRnqEy1B5HfM9Q5e7vJ6C5def)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="evidence_cid_3" elementType="Argument"><stringProp name="Argument.name">evidence_cid_3</stringProp><stringProp name="Argument.value">${__P(evidence_cid_3,QmYwAPJzv5CZsnAzt8auVZRnqEy1B5HfM9Q5e7vJ6C6ghi)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></Arguments><hashTree />
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults" enabled="true"><stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp><stringProp name="HTTPSampler.port">${__P(port,4000)}</stringProp><stringProp name="HTTPSampler.protocol">${__P(protocol,http)}</stringProp><stringProp name="HTTPSampler.connect_timeout">5000</stringProp><stringProp name="HTTPSampler.response_timeout">30000</stringProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true"><collectionProp name="Arguments.arguments" /></elementProp></ConfigTestElement><hashTree />
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="JSON and Dynamic Authorization" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="Content-Type" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp><elementProp name="Accept" elementType="Header"><stringProp name="Header.name">Accept</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp><elementProp name="Authorization" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${current_token}</stringProp></elementProp><elementProp name="X-Request-Id" elementType="Header"><stringProp name="Header.name">X-Request-Id</stringProp><stringProp name="Header.value">${__UUID}</stringProp></elementProp></collectionProp></HeaderManager><hashTree />
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      


      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="KYC to Disbursement E2E" enabled="true"><stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Single E2E iteration" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">1</stringProp><stringProp name="ThreadGroup.ramp_time">0</stringProp><stringProp name="ThreadGroup.duration"></stringProp><stringProp name="ThreadGroup.delay"></stringProp><boolProp name="ThreadGroup.scheduler">false</boolProp></ThreadGroup><hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Start E2E timer" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">vars.put('e2e_start_ms', System.currentTimeMillis().toString()); vars.put('project_deadline', java.time.Instant.now().plus(30, java.time.temporal.ChronoUnit.DAYS).toString()); vars.put('project_status', 'PENDING_ACTIVATION'); vars.put('activation_polls', '0'); vars.put('disbursement_status', 'PENDING'); vars.put('payos_status', 'PENDING'); vars.put('disbursement_polls', '0')</stringProp></JSR223Sampler><hashTree /><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Use KYC token" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">vars.put('current_token', vars.get('kyc_access_token'))</stringProp></JSR223Sampler><hashTree /><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Submit organization KYC" enabled="true"><stringProp name="HTTPSampler.path">/auth/organization/kyc-submissions</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="body" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{"organizationName":"${__P(kyc_org_name,DCP E2E Test Organization)}","legalRegistrationNumber":"${__P(kyc_legal_registration_number,DCP-E2E-CHANGE-ME)}","officialWebsite":"https://example.org","organizationDescription":"Isolated E2E performance test organization.","files":[{"fileName":"registration.pdf","mimeType":"application/pdf","fileSize":8,"base64Content":"${__P(kyc_file_base64,JVBERi0xLjQK)}","documentType":"LEGAL_REGISTRATION"}]}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp></HTTPSamplerProxy><hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="HTTP 2xx" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="2xx">2[0-9][0-9]</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">4</intProp></ResponseAssertion><hashTree /><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract kyc_submission_id" enabled="true"><stringProp name="JSONPostProcessor.referenceNames">kyc_submission_id</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.submission.submissionId</stringProp><stringProp name="JSONPostProcessor.match_numbers">1</stringProp></JSONPostProcessor><hashTree /></hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Use regulatory token" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">vars.put('current_token', vars.get('regulatory_access_token'))</stringProp></JSR223Sampler><hashTree /><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Approve organization KYC" enabled="true"><stringProp name="HTTPSampler.path">/auth/organization/kyc-submissions/${kyc_submission_id}/review</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><stringProp name="HTTPSampler.method">PATCH</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="body" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{"action":"approve"}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp></HTTPSamplerProxy><hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="HTTP 2xx" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="2xx">2[0-9][0-9]</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">4</intProp></ResponseAssertion><hashTree /></hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Use post-KYC organization token" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">vars.put('current_token', vars.get('organization_access_token'))</stringProp></JSR223Sampler><hashTree /><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Submit beneficiary bank account" enabled="true"><stringProp name="HTTPSampler.path">/auth/organization/kyc-submissions/me/beneficiary-bank-account</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="body" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{"bankName":"Vietcombank","bankAccountNumber":"${__P(bank_account_number,970400000001)}","accountHolderName":"DCP E2E TEST","branchName":"Ho Chi Minh"}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp></HTTPSamplerProxy><hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="HTTP 2xx" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="2xx">2[0-9][0-9]</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">4</intProp></ResponseAssertion><hashTree /><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract bank_submission_id" enabled="true"><stringProp name="JSONPostProcessor.referenceNames">bank_submission_id</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.submission.submissionId</stringProp><stringProp name="JSONPostProcessor.match_numbers">1</stringProp></JSONPostProcessor><hashTree /></hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Use regulatory token for bank review" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">vars.put('current_token', vars.get('regulatory_access_token'))</stringProp></JSR223Sampler><hashTree /><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Approve beneficiary bank account" enabled="true"><stringProp name="HTTPSampler.path">/auth/organization/kyc-submissions/${bank_submission_id}/review</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><stringProp name="HTTPSampler.method">PATCH</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="body" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{"action":"approve"}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp></HTTPSamplerProxy><hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="HTTP 2xx" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="2xx">2[0-9][0-9]</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">4</intProp></ResponseAssertion><hashTree /></hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Use organization token for project" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">vars.put('current_token', vars.get('organization_access_token'))</stringProp></JSR223Sampler><hashTree /><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Create project" enabled="true"><stringProp name="HTTPSampler.path">/projects</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="body" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{"name":"DCP E2E ${__UUID}","description":"Isolated end-to-end project for KYC and disbursement timing.","goalAmount":1000000,"deadline":"${project_deadline}","evidenceCids":["${evidence_cid_1}","${evidence_cid_2}","${evidence_cid_3}"],"milestonePlan":[{"milestoneIndex":1,"milestoneKey":"M1_ADVANCE","percentage":25,"description":"Initial construction advance for the project."},{"milestoneIndex":2,"milestoneKey":"M2_CONSTRUCTION","percentage":50,"description":"Construction progress and verified usage evidence."},{"milestoneIndex":3,"milestoneKey":"M3_HANDOVER","percentage":25,"description":"Final handover and completion verification."}]}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp></HTTPSamplerProxy><hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="HTTP 2xx" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="2xx">2[0-9][0-9]</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">4</intProp></ResponseAssertion><hashTree /><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract project_id" enabled="true"><stringProp name="JSONPostProcessor.referenceNames">project_id</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.data.projectId</stringProp><stringProp name="JSONPostProcessor.match_numbers">1</stringProp></JSONPostProcessor><hashTree /></hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Create project geofence" enabled="true"><stringProp name="HTTPSampler.path">/api/oracle/geofence/${project_id}</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="body" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{"polygon":[{"lat":10.770,"lng":106.690},{"lat":10.771,"lng":106.690},{"lat":10.771,"lng":106.691},{"lat":10.770,"lng":106.691}],"radiusMeters":500}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp></HTTPSamplerProxy><hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="HTTP 2xx" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="2xx">2[0-9][0-9]</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">4</intProp></ResponseAssertion><hashTree /></hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Use regulatory token for project review" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">vars.put('current_token', vars.get('regulatory_access_token'))</stringProp></JSR223Sampler><hashTree /><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Submit project" enabled="true"><stringProp name="HTTPSampler.path">/projects/submit</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="body" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{"projectId":"${project_id}"}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp></HTTPSamplerProxy><hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="HTTP 2xx" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="2xx">2[0-9][0-9]</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">4</intProp></ResponseAssertion><hashTree /></hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Approve project" enabled="true"><stringProp name="HTTPSampler.path">/projects/review</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="body" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{"projectId":"${project_id}","action":"APPROVE"}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp></HTTPSamplerProxy><hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="HTTP 2xx" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="2xx">2[0-9][0-9]</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">4</intProp></ResponseAssertion><hashTree /></hashTree><WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="Wait until project ACTIVE" enabled="true"><stringProp name="WhileController.condition">${__javaScript("${project_status}" != "ACTIVE" &amp;&amp; "${activation_polls}" &lt; "180",)}</stringProp></WhileController><hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Use donor token for project status" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">vars.put('current_token', vars.get('donor_access_token'))</stringProp></JSR223Sampler><hashTree /><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Read project status" enabled="true"><stringProp name="HTTPSampler.path">/projects/public-support/${project_id}</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><stringProp name="HTTPSampler.method">GET<