milliseconds" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">if (vars.get('disbursement_status') != 'COMPLETED' || vars.get('payos_status') != 'SUCCESS') { SampleResult.setSuccessful(false); throw new AssertionError('Disbursement did not reach COMPLETED/SUCCESS before polling timeout'); }; def elapsed = System.currentTimeMillis() - (vars.get('e2e_start_ms') as long); log.info('DCP_E2E_MS=' + elapsed + '; projectId=' + vars.get('project_id') + '; requestId=' + vars.get('request_id') + '; disbursementStatus=' + vars.get('disbursement_status') + '; payosStatus=' + vars.get('payos_status')); SampleResult.setResponseData(('e2e_ms=' + elapsed).getBytes('UTF-8'))</stringProp></JSR223Sampler><hashTree /></hashTree><ResultCollector guiclass="SummaryReport" testclass="ResultCollector" testname="Summary Report" enabled="true"><boolProp name="ResultCollector.error_logging">false</boolProp><objProp><name>saveConfig</name><value class="SampleSaveConfiguration"><time>true</time><latency>true</latency><timestamp>true</timestamp><success>true</success><label>true</label><code>true</code><message>true</message><threadName>true</threadName><dataType>true</dataType><encoding>false</encoding><responseData>false</responseData><samplerData>false</samplerData><xml>false</xml><fieldNames>true</fieldNames><responseDataOnError>true</responseDataOnError><saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage><assertionsResultsToSave>0</assertionsResultsToSave><url>true</url><threadCounts>true</threadCounts><connectTime>true</connectTime></value></objProp><stringProp name="filename"></stringProp></ResultCollector><hashTree />
