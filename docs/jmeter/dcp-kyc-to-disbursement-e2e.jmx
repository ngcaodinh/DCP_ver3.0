<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="DCP KYC to Disbursement E2E" enabled="true">
      <stringProp name="TestPlan.comments">One real sandbox E2E flow. Requires sandbox tokens, PayOS/RPC/workers and committee private keys. Never point at production.</stringProp>
