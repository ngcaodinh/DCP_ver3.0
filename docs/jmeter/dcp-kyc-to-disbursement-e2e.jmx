ow', java.time.Instant.now().toString())</stringProp></JSR223Sampler><hashTree /><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Use organization token for disbursement" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">vars.put('current_token', vars.get('organization_access_token'))</stringProp></JSR223Sampler><hashTree /><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Create disbursement" enabled="true"><stringProp name="HTTPSampler.path">/api/disbursement/create</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="body" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{"projectId":"${project_id}","amount":${e2e_disbursement_amount},"usagePurpose":"Construction milestone payment for E2E timing test.","evidencePhotos":[{"fileName":"capture-1.jpg","mimeType":"image/jpeg","contentBase64":"${evidence_photo_base64}","gps":{"latitude":10.7705,"longitude":106.6905},"accuracyMeters":20,"capturedAtClient":"${evidence_now}","geolocationTimestamp":"${evidence_now}","lowAccuracyOverride":false,"overrideUnlockedAfterMs":null,"lowAccuracyReason":null}],"clientSubmittedAt":"${evidence_now}","requestMode":"NORMAL","beneficiaryBankAccount":{"bankName":"Vietcombank","bankAccountNumber":"${__P(bank_account_number,970400000001)}","accountHolderName":"DCP E2E TEST","branchName":"Ho Chi Minh"}}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp></HTTPSamplerProxy><hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="HTTP 2xx" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="2xx">2[0-9][0-9]</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">4</intProp></ResponseAssertion><hashTree /><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract request_id" enabled="true"><stringProp name="JSONPostProcessor.referenceNames">request_id</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.data.requestId</stringProp><stringProp name="JSONPostProcessor.match_numbers">1</stringProp></JSONPostProcessor><hashTree /></hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Use Chair token" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">vars.put('current_token', vars.get('committee_chair_access_token'))</stringProp></JSR223Sampler><hashTree /><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Chair signing payload" enabled="true"><stringProp name="HTTPSampler.path">/api/disbursement/executive/${request_id}/signing-payload</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="body" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{"decision":"APPROVE","reason":"E2E performance test chair approves this disbursement."}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp></HTTPSamplerProxy><hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="HTTP 2xx" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="2xx">2[0-9][0-9]</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">4</intProp></ResponseAssertion><hashTree /><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract chair_payload" enabled="true"><stringProp name="JSONPostProcessor.referenceNames">chair_payload</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.data</stringProp><stringProp name="JSONPostProcessor.match_numbers">1</stringProp></JSONPostProcessor><hashTree /></hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Sign Chair EIP-712 payload" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">def p = new ProcessBuilder('node', new java.io.File(vars.get('repo_root'), 'BE/scripts/signCommitteeVoteForJmeter.mjs').absolutePath, 'CHAIR').start(); p.outputStream.withWriter('UTF-8') { it &lt;&lt; vars.get('chair_payload') }; def out = p.inputStream.getText('UTF-8'); def err = p.errorStream.getText('UTF-8'); if (p.waitFor() != 0) throw new RuntimeException('Committee signer failed'); def s = new groovy.json.JsonSlurper().parseText(out); vars.put('chair_signature', s.signature as String); vars.put('chair_signing_request_id', s.signingRequestId as String)</stringProp></JSR223Sampler><hashTree /><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Chair vote" enabled="true"><stringProp name="HTTPSampler.path">/api/