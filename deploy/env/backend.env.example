PORT=4000
NODE_ENV=production
MONGODB_URI=mongodb://dcp_app:CHANGE_ME_APP_PASSWORD@mongo:27017/dcp?authSource=dcp
REDIS_URL=redis://redis:6379
CORS_ALLOWED_ORIGINS=https://dcp.example.com
REQUEST_BODY_LIMIT=5mb
RUN_WORKERS=false
# Bật true trên đúng một container BE để purge feedback đã xoá mềm sau 30 ngày.
FEEDBACK_PURGE_ENABLED=
FRONTEND_URL=https://dcp.example.com

# Bí mật dùng khi chạy feedback công khai; tạo giá trị ngẫu nhiên tối thiểu 32 ký tự trên VPS.
FEEDBACK_TICKET_HMAC_KEY=
FEEDBACK_IP_HASH_SALT=

GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET

JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET_MIN_32_CHARS
JWT_ISSUER=dcp-backend
JWT_AUDIENCE=dcp-users
JWT_EXPIRES_IN=24h
