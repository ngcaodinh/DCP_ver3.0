PORT=4000
NODE_ENV=production
MONGODB_URI=mongodb://dcp_app:CHANGE_ME_APP_PASSWORD@mongo:27017/dcp?authSource=dcp
REDIS_URL=redis://redis:6379
CORS_ALLOWED_ORIGINS=https://dcp.example.com
REQUEST_BODY_LIMIT=5mb
RUN_WORKERS=false
EVENT_LOGGER_ENABLED=true
EVENT_LOGGER_TICK_MS=5000
EVENT_LOGGER_BATCH_SIZE=100
EVENT_LOGGER_FLUSH_INTERVAL_MS=300000
EVENT_LOGGER_INFLIGHT_RECOVERY_INTERVAL_MS=60000
EVENT_LOGGER_BUFFER_MAX=50000
EVENT_ARCHIVE_ENABLED=false
# Bật true trên đúng một container BE để purge feedback đã xoá mềm sau 30 ngày.
FEEDBACK_PURGE_ENABLED=
FRONTEND_URL=https://dcp.example.com

# Donation Certificate — bật sau khi chạy migration index và kiểm tra template/font trong image.
DONATION_CERTIFICATE_ENABLED=false
DONATION_CERTIFICATE_START_AT=2026-08-31T00:00:00.000Z
DONATION_CERTIFICATE_FINALITY_MODE=AUTO
DONATION_CERTIFICATE_FINALITY_POLL_MS=2000
DONATION_CERTIFICATE_FALLBACK_CONFIRMATIONS=12
BLOCKCHAIN_CHAIN_ID=80002
BLOCKCHAIN_NETWORK_NAME=Polygon Amoy
DONATION_RANKING_CONTRACT_ADDRESS=0xCHANGE_ME_DONATION_RANKING_CONTRACT_ADDRESS
BLOCKCHAIN_EXPLORER_TX_BASE_URL=https://amoy.polygonscan.com/tx

# Gmail SMTP — dùng App Password, không dùng mật khẩu tài khoản chính.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=DCP Notification <your_email@gmail.com>

# Chỉ là giá trị mẫu; thay bằng địa chỉ CommitteeGovernance của network triển khai.
COMMITTEE_GOVERNANCE_ADDRESS=your_committee_governance_address
# RPC và deployment block là bắt buộc để startup reconcile/bootstrap và projector đọc đủ lịch sử.
BLOCKCHAIN_RPC_URL=https://your-rpc-provider.example
COMMITTEE_GOVERNANCE_DEPLOYMENT_BLOCK=0
# MultisigDisbursement được reconciliation worker dùng để khôi phục request sau restart.
MULTISIG_DISBURSEMENT_ADDRESS=your_multisig_disbursement_address
MULTISIG_DISBURSEMENT_DEPLOYMENT_BLOCK=0
# Chỉ cấp secret này cho đúng một worker profile; API-only profile phải để RUN_WORKERS=false.
COMMITTEE_GOVERNANCE_RELAYER_PRIVATE_KEY=
ENABLE_COMMITTEE_DECISION_RELAYER_WORKER=false
ADMIN_LOGIN_WALLET_ADDRESSES=0xYOUR_ADMIN_LOGIN_WALLET_ADDRESS
ENABLE_DISBURSEMENT_ONCHAIN_SIGNER_WORKER=false
DISBURSEMENT_SERVICE_SIGNER_ADMIN_KEY=
DISBURSEMENT_SERVICE_SIGNER_ORG_KEY=
DISBURSEMENT_SERVICE_SIGNER_REGULATORY_KEY=

# Bí mật dùng khi chạy feedback công khai; tạo giá trị ngẫu nhiên tối thiểu 32 ký tự trên VPS.
FEEDBACK_TICKET_HMAC_KEY=
FEEDBACK_IP_HASH_SALT=

GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET

JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET_MIN_32_CHARS
JWT_ISSUER=dcp-backend
JWT_AUDIENCE=dcp-users
JWT_EXPIRES_IN=24h
