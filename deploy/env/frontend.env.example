NODE_ENV=production
NEXT_PUBLIC_API_BASE_URL=https://api.dcp.example.com
BACKEND_INTERNAL_URL=http://backend:4000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
NEXT_PUBLIC_AMOY_CHAIN_ID=80002
NEXT_PUBLIC_BLOCKCHAIN_CHAIN_ID=80002
NEXT_PUBLIC_BLOCKCHAIN_EXPLORER_TX_BASE_URL=https://amoy.polygonscan.com/tx
NEXT_PUBLIC_CHARITY_TOKEN_ADDRESS=0xCHANGE_ME_CHARITY_TOKEN_ADDRESS
NEXT_PUBLIC_DONATION_RANKING_ADDRESS=0xCHANGE_ME_DONATION_RANKING_ADDRESS
NEXT_PUBLIC_DONATION_RANKING_CONTRACT_ADDRESS=0xCHANGE_ME_DONATION_RANKING_CONTRACT_ADDRESS
# Chỉ là giá trị mẫu; thay bằng địa chỉ CommitteeGovernance của network triển khai.
NEXT_PUBLIC_COMMITTEE_GOVERNANCE_ADDRESS=0xCHANGE_ME_COMMITTEE_GOVERNANCE_ADDRESS
# Block deploy thật của CommitteeGovernance; không để 0 khi production.
NEXT_PUBLIC_COMMITTEE_GOVERNANCE_DEPLOYMENT_BLOCK=0
