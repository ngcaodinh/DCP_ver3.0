# ===========================================
# ImpactSBT Contract Deployment Configuration
# ===========================================

# RPC URL for Amoy testnet (Polygon Amoy)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Deployer private key (NEVER commit this to git!)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Polygonscan API Key (for contract verification on mainnet)
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# OkLink API Key (for Amoy testnet verification)
# Get from: https://www.oklink.com/amoy
AMOY_EXPLORER_API_KEY=your_amoy_explorer_api_key

# Oracle address for ImpactSBT (must be a valid address)
# This address will be granted ORACLE_ROLE to mint SBTs
ORACLE_ADDRESS=0x0000000000000000000000000000000000000000

