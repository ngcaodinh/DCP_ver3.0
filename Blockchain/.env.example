# ===========================================
# ImpactSBT Contract Deployment Configuration
# ===========================================

# RPC URL for Amoy testnet (Polygon Amoy)
AMOY_RPC_URL=https://polygon-amoy.drpc.org

# Deployer private key (NEVER commit this to git!)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Polygonscan API Key (for contract verification on mainnet)
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# OkLink API Key (for Amoy testnet verification)
# Get from: https://www.oklink.com/amoy
AMOY_EXPLORER_API_KEY=your_amoy_explorer_api_key

# Oracle address for ImpactSBT (must be a valid address)
# Must be the address derived from BE IMPACT_SBT_MINTER_PRIVATE_KEY.
# This address will be granted ORACLE_ROLE to mint SBTs.
ORACLE_ADDRESS=0x0000000000000000000000000000000000000000

# ================================================
# AuditorStaking Contract Deployment Configuration
# ================================================

# DCP Charity Token used for auditor stake and rewards.
CHARITY_TOKEN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Minimum DCT stake required to activate the auditor role.
AUDITOR_STAKE_INITIAL_THRESHOLD=3000000

# Must be the address derived from BE AUDITOR_STAKING_ORACLE_PRIVATE_KEY.
# Never commit that private key or any real production secret.
AUDITOR_STAKING_SLASHER_ADDRESS=0x0000000000000000000000000000000000000000

# Treasury multisig/EOA riêng giữ DEFAULT_ADMIN_ROLE để fundRewardPool, pause và quản trị staking.
# Không dùng deployer hoặc oracle/slasher làm treasury vận hành hằng ngày.
AUDITOR_STAKING_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

