# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
BACKEND_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# Google Authentication
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# Blockchain Network Configuration (Polygon Amoy Testnet)
NEXT_PUBLIC_AMOY_CHAIN_ID=80002
NEXT_PUBLIC_BLOCKCHAIN_CHAIN_ID=80002

# Smart Contract Addresses
NEXT_PUBLIC_CHARITY_TOKEN_ADDRESS=0x...
NEXT_PUBLIC_DONATION_RANKING_ADDRESS=0x...

# Standardized variable for donationWeb3Client compatibility
NEXT_PUBLIC_DONATION_RANKING_CONTRACT_ADDRESS=0x...

# Polygon Amoy RPC — dùng public endpoint không cần API key
# Ưu tiên: rpc-amoy.polygon.technology > polygon-amoy.drpc.org > polygon-amoy-bor-rpc.publicnode.com
NEXT_PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology

# ZeroDev Bundler v3 (Polygon Amoy) — thay {PROJECT_ID} bằng ZeroDev Project ID
NEXT_PUBLIC_BUNDLER_URL=https://rpc.zerodev.app/api/v3/{PROJECT_ID}/chain/80002
NEXT_PUBLIC_ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# ==========================================#
# ===== E7 - Sentry error tracking ========#
# ==========================================#
# NEXT_PUBLIC_* được inline lúc next build, đổi DSN bắt buộc phải rebuild image.
NEXT_PUBLIC_SENTRY_DSN=

# Nhãn environment cho event từ browser.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
